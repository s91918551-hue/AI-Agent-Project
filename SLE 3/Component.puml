
@startuml MazeComponent
title C4 Level 3 - Component Diagram
left to right direction
skinparam componentStyle rectangle

package "Maze Solving Application" {
  component "Maze Loader" as Loader
  component "Maze Validator" as Validator
  component "Search Controller" as Controller
  component "BFS Search" as BFS
  component "DFS Search" as DFS
  component "Visited Node Tracker" as Visited
  component "Path Reconstructor" as Path
  component "Result Display" as Display
}

Loader --> Validator : Maze data
Validator --> Controller : Valid maze
Controller --> BFS : Run BFS
Controller --> DFS : Run DFS
BFS --> Visited : Track visited nodes
DFS --> Visited : Track visited nodes
BFS --> Path : Found goal
DFS --> Path : Found goal
Path --> Display : Final path
@enduml
