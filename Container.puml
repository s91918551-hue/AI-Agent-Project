
@startuml MazeContainer
title C4 Level 2 - Container Diagram
left to right direction
skinparam componentStyle rectangle

actor "User" as user

rectangle "Maze Solving System" {
  component "User Interface\n(Python)" as UI
  component "Maze Input Handler" as Input
  component "BFS Algorithm" as BFS
  component "DFS Algorithm" as DFS
  component "Path Visualizer" as Visualizer
}

user --> UI : Enter maze\nSelect algorithm
UI --> Input : Maze data
Input --> BFS : Search using BFS
Input --> DFS : Search using DFS
BFS --> Visualizer : Solution path
DFS --> Visualizer : Solution path
Visualizer --> UI : Display result
@enduml
